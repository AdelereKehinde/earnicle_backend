# Supabase Postgres connection string (used as DB host only — no Supabase SDK)
# Get from: Supabase Dashboard -> Project Settings -> Database -> Connection string
# Use the pooler URL (port 6543) for production, format adjusted for asyncpg:
DATABASE_URL=postgresql+asyncpg://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-a-long-random-secret

# Paystack — server-only, never exposed to the client
PAYSTACK_SECRET_KEY=sk_test_xxx

# Cloudinary — API secret is server-only; cloud name/preset are public-safe
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx
CLOUDINARY_CLOUD_NAME=dcagartnn
CLOUDINARY_UPLOAD_PRESET=earnicle_avatars

# Resend — get a key at resend.com, verify a sending domain for production
# (their test domain onboarding@resend.dev only delivers to your own signup email)
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=Earnicle <onboarding@resend.dev>

# Comma-separated list of allowed origins for the mobile app / dev server
CORS_ORIGINS=*

# Set to 1 only in local dev to auto-create tables from models.py.
# Use Alembic migrations instead for anything beyond local testing.
AUTO_CREATE_TABLES=0
